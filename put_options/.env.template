# Options Trading Bot - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# AngelOne API Credentials
# =============================================================================

# Get these from AngelOne SmartAPI portal
# https://smartapi.angelbroking.com/

ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_CODE=your_client_code_here
ANGEL_PASSWORD=your_password_here
ANGEL_TOTP_KEY=your_totp_key_here

# =============================================================================
# Options Trading Configuration
# =============================================================================

# Trading mode: PAPER (simulation) or LIVE (real trading)
# WARNING: Only use LIVE after thorough testing!
TRADING_MODE=PAPER

# Capital Management (in Rupees) - Lower than equity due to leverage
OPTIONS_MAX_CAPITAL=50000
OPTIONS_CAP_PER_TRADE=5000
OPTIONS_MAX_SLOTS=3
OPTIONS_RESERVE_CAPITAL=5000

# Options-specific risk parameters
OPTIONS_DEFAULT_SL_PERCENTAGE=1.0
OPTIONS_TARGET_PERCENTAGE=2.0

# Number of lots per trade (for scaling: increase this to scale trade size)
# Each option contract = 1 lot
# Example: NO_OF_LOTS=1 places 1 lot (qty=lot_size), NO_OF_LOTS=2 places 2 lots (qty=2*lot_size)
NO_OF_LOTS=1

# =============================================================================
# Webhook Server Configuration
# =============================================================================

# Webhook server settings (different port from equity bot)
WEBHOOK_HOST=0.0.0.0
OPTIONS_WEBHOOK_PORT=8081
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Monitor interval in seconds
MONITOR_INTERVAL=20

# Order confirmation timeout in seconds
ORDER_TIMEOUT=30

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# Log retention in days
LOG_RETENTION_DAYS=30

# =============================================================================
# Development and Testing
# =============================================================================

# Testing mode (for unit tests)
TESTING_MODE=False

# Debug mode
DEBUG_MODE=True

# =============================================================================
# IMPORTANT NOTES
# =============================================================================

# 1. NEVER commit the actual .env file to version control
# 2. Start with TRADING_MODE=PAPER for testing
# 3. Only switch to TRADING_MODE=LIVE after thorough testing
# 4. Keep your TOTP_KEY secure - it's like your password
# 5. Use a strong WEBHOOK_SECRET for TradingView integration
# 6. Monitor logs regularly in the logs/YYYY-MM-DD/ directory
# 7. Options bot uses port 8081 (different from equity bot on port 80)
# 8. Store credentials securely - never share them

# =============================================================================
# How to get AngelOne credentials:
# =============================================================================

# 1. Register at https://smartapi.angelbroking.com/
# 2. Create API credentials in the developer section
# 3. Enable TOTP (Time-based One-Time Password) in your account
# 4. Use Google Authenticator or similar app to get TOTP_KEY
# 5. The TOTP_KEY is the QR code secret (base32 string)

# =============================================================================
# Capital Management Examples:
# =============================================================================

# Conservative Setup:
# OPTIONS_MAX_CAPITAL=50000
# OPTIONS_CAP_PER_TRADE=5000
# OPTIONS_MAX_SLOTS=3

# Moderate Setup:
# OPTIONS_MAX_CAPITAL=100000
# OPTIONS_CAP_PER_TRADE=10000
# OPTIONS_MAX_SLOTS=5

# Aggressive Setup:
# OPTIONS_MAX_CAPITAL=250000
# OPTIONS_CAP_PER_TRADE=25000
# OPTIONS_MAX_SLOTS=10
