//@version=6
indicator("Sniper 7.28-E – Pullback + Momentum Hybrid", overlay=true)

//──────── INPUTS ────────
emaShort = input.int(9)
emaLong = input.int(20)
rsiLen = input.int(14)
atrLen = input.int(14)
volLen = input.int(20)

minRsi = input.float(58.0)
maxRsi = input.float(85.0)
minAtrPc = input.float(0.06)
minBody = input.float(0.45)
maxPullbackDepth = input.float(0.8)

//──────── CORE ────────
ema9 = ta.ema(close, emaShort)
ema20 = ta.ema(close, emaLong)
vwap = ta.vwap(hlc3)
rsi = ta.rsi(close, rsiLen)
atr = ta.atr(atrLen)
atrPc = atr / close * 100.0

body = math.abs(close - open)
barRange = math.max(high - low, 0.0)
bodyRatio = barRange == 0.0 ? 0.0 : body / barRange
volAvg = ta.sma(volume, volLen)

//──────── TIME ────────
barCloseTime = time + timeframe.multiplier * 60000
tradeStart = timestamp("GMT+5:30", year, month, dayofmonth, 9, 30)
tradeEnd = timestamp("GMT+5:30", year, month, dayofmonth, 11, 30)
inTradeWindow = barCloseTime >= tradeStart and barCloseTime <= tradeEnd

//──────── DAILY CONTEXT ────────
pdc = request.security(syminfo.tickerid, "D", close[1])
pdcConfirm = close > pdc

//──────── FILTERS ────────
fAboveMA = close > ema9 and close > ema20 and close > vwap
fRSI = rsi >= minRsi and rsi <= maxRsi
fATR = atrPc >= minAtrPc
fVolume = volume > volAvg * 1.15 or volume > volume[1] * 1.05
fBody = bodyRatio >= minBody

//──────── BREAKOUT CONTEXT ────────
allFilters = fAboveMA and fRSI and fATR and fVolume and fBody and pdcConfirm and inTradeWindow
breakout = allFilters
recentBreakout = ta.barssince(breakout) <= 7

//──────── TREND STRENGTH ────────
emaSpread = (ema9 - ema20) / ema20 * 100
strongTrend = emaSpread > 0.15

vwapDistance = (close - vwap) / vwap * 100
healthyMomentum = vwapDistance > 0.2

rsiHolding = rsi > 55

trendHealthy = strongTrend and healthyMomentum and rsiHolding

//════════════════════════════════════
// 🔵 PULLBACK ENTRY
//════════════════════════════════════
pullback = close > ema20 and close <= ema9
recentPullback = ta.barssince(pullback) <= 3

higherLow = ta.lowest(low, 3) > ta.lowest(low, 6)
aboveVWAP = close > vwap

strongBullCandle = close > open and bodyRatio > 0.5
reclaim = close > ema9 and strongBullCandle

pullbackVol = volume > volAvg or ta.valuewhen(pullback, volume, 0) > volAvg

pullbackDepth = (ema9 - close) / ema9 * 100
pullbackDepthAtEntry = ta.valuewhen(pullback, pullbackDepth, 0)
validDepth = pullbackDepthAtEntry >= 0 and pullbackDepthAtEntry <= maxPullbackDepth

pullbackEntry = recentBreakout and recentPullback and reclaim and higherLow and aboveVWAP and pullbackVol and validDepth and trendHealthy and inTradeWindow
pullbackTrigger = pullbackEntry and not pullbackEntry[1]

//════════════════════════════════════
// 🔴 MOMENTUM ENTRY (NEW)
//════════════════════════════════════
strongMomentumCandle = close > open and bodyRatio > 0.6
momentumEntry = breakout and strongMomentumCandle and trendHealthy and inTradeWindow
momentumTrigger = momentumEntry and not momentumEntry[1]

//════════════════════════════════════
// 🎯 FINAL TRIGGER
//════════════════════════════════════
finalTrigger = (pullbackTrigger or momentumTrigger)

// Entry type
entryType = pullbackTrigger ? "PULLBACK" : momentumTrigger ? "MOMENTUM" : "NONE"

//════════════════════════════════════
// 📊 SCORE
//════════════════════════════════════
score = 0.0
score += fAboveMA ? 12.5 : 0
score += fRSI ? 12.5 : 0
score += fATR ? 12.5 : 0
score += fVolume ? 12.5 : 0
score += fBody ? 12.5 : 0
score += pdcConfirm ? 12.5 : 0

confidence = finalTrigger ? math.min(95.0, 75.0 + score * 0.4) : 0.0

//════════════════════════════════════
// 📈 NIFTY TREND
//════════════════════════════════════
// NIFTY data
n_close = request.security("NSE:NIFTY", timeframe.period, close)
n_open = request.security("NSE:NIFTY", "D", open)
n_vwap = request.security("NSE:NIFTY", timeframe.period, ta.vwap(hlc3))

move_from_open = (n_close - n_open) / n_open * 100

market_trend = "NEUTRAL"

if move_from_open >= 0.4 and n_close > n_vwap
    market_trend := "GOOD"
else if move_from_open <= -0.3 or (n_close < n_vwap and move_from_open < 0.2)
    market_trend := "BAD"

//════════════════════════════════════
// 📦 JSON ALERT
//════════════════════════════════════
fmt(x) => str.tostring(x, format.mintick)

jsonMsg = "{\"symbol\":\""+syminfo.ticker+"\",\"action\":\"BUY\",\"entry_type\":\""+entryType+"\",\"price\":\""+fmt(close)+"\",\"score\":\""+fmt(score)+"\",\"confidence\":\""+fmt(confidence)+"\",\"market_trend\":\""+market_trend+"\",\"trend_strength\":\""+fmt(emaSpread)+"\",\"momentum_score\":\""+fmt(vwapDistance)+"\"}"

//════════════════════════════════════
// 🔔 ALERT CONTROL
//════════════════════════════════════
var bool alertedToday = false
newDay = ta.change(time("D")) != 0
if newDay
    alertedToday := false

if finalTrigger and not alertedToday
    alertedToday := true
    alert(jsonMsg, alert.freq_once_per_bar_close)

//════════════════════════════════════
// 📊 PLOTS
//════════════════════════════════════
plot(ema9, color=color.yellow)
plot(ema20, color=color.orange)
plot(vwap, color=color.blue)