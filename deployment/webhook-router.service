[Unit]
Description=TradingView Webhook Router - Forwards alerts to both equity and options bots
Documentation=https://github.com/santhosh/webhook-router
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/root/santhosh/trading

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/santhosh/trading
Environment=PATH=/root/santhosh/trading/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/root/santhosh/trading
Environment=ROUTER_PORT=80
Environment=EQUITY_BOT_URL=http://127.0.0.1:8080/webhook
Environment=OPTIONS_BOT_URL=http://127.0.0.1:8081/webhook/options
ExecStart=/usr/bin/python3 /root/santhosh/trading/webhook_router.py
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=10

# Resource limits
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=50%

# Security
NoNewPrivileges=true
ProtectSystem=false
ProtectHome=false
ReadWritePaths=/root/santhosh/trading

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=webhook-router

[Install]
WantedBy=multi-user.target
