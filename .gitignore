CE_OPTIONS/OTM/data/
CE_OPTIONS/ITM/data/
PUT_OPTIONS/OTM/data/
PUT_OPTIONS/ITM/data/
# Root-level data caches
CE_OPTIONS/data/
PUT_OPTIONS/data/
# Equity bot runtime data
equity/data/positions.json
equity/data/session.json
equity/data/trades.csv
equity/data/*.jsonl

# =============================================================================
