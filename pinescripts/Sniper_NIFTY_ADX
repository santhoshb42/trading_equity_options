//@version=6
indicator("Sniper NIFTY ADX-Ignition v1 (1-Min) — CE+PUT", overlay=true, max_labels_count=500)
// ============================================================================
// NIFTY INDEX signal (2026-07-25). PAPER-TEST ONLY — see honesty note below.
// Thesis (user): an index doesn't lurch like a stock, so the tradeable moment is when the trend
// is IGNITING — ADX turning UP from a low base, the session VWAP just starting to slope, and RSI
// crossing ~50 — rather than a mature ADX>=35 / RSI>=68 momentum burst (which NIFTY almost never
// prints; measured max 5-min move = 0.26%, so the stock thrust>=0.4% gate fires ZERO on NIFTY).
//
// BACKTEST (60 days NIFTY 1-min -> 5-min):
//   * Entry direction WORKS: ADX-ignition + VWAP + RSI-50 = ~60-63% PUT win rate at a 60-min hold
//     (best on the PUT side, best when ADX < 30 at entry). Genuinely the best entry WR we've found.
//   * BUT it LOSES money as an option BUYER: NIFTY's moves (~+0.057% median) are too small to beat
//     option friction+theta (gross edge ~+0.44%/trade < ~1-1.5% round-trip cost). Net negative.
//   * The MACD-shift as a REQUIRED gate made it WORSE (32% WR) — coin-flip filter diluting the
//     edge — so it is an OPTIONAL confirmation here, DEFAULT OFF.
//   => Ship to PAPER to see if real NIFTY option fills beat the friction assumption. Do NOT put
//      real money on it without a positive PAPER record. (Theta-SELLING is the likely real edge on
//      this signal, but that's a separate strategy the bot isn't built for — parked.)
//
// VOLUME NOTE: the NIFTY SPOT index has no volume, so a true VWAP can't be computed. This uses a
// SESSION-ANCHORED MEAN of hlc3 (equal-weight) as the VWAP proxy — matches the backtest and works
// with zero volume. For a truer VWAP, run this on NIFTY FUTURES (which has volume); the signal may
// shift. CE+PUT in ONE script; entry + exit labels; JSON alerts match the bot's payload format.
// ============================================================================

// ── indicators ──
rsiLen   = input.int(14, "RSI Length", group="Indicators")
adxLen   = input.int(14, "ADX Length", group="Indicators")
macdFast = input.int(12, "MACD Fast", group="Indicators")
macdSlow = input.int(26, "MACD Slow", group="Indicators")
macdSig  = input.int(9,  "MACD Signal", group="Indicators")

// ── entry thresholds (index-calibrated, from the backtest) ──
adxRiseBars   = input.int(3, "ADX must be RISING over N bars", minval=1, maxval=6, group="Entry")
vwapSlopeBars = input.int(3, "VWAP slope lookback (bars)", minval=1, maxval=6, group="Entry")
useAdxCap     = input.bool(true, "Only enter while ADX is still LOW (igniting, not mature)", group="Entry")
adxCap        = input.float(30.0, "  ADX cap for entry", minval=15, group="Entry")
rsiCE         = input.float(49.0, "CE: RSI must be >= (through midline up)", group="Entry")
rsiPUT        = input.float(51.0, "PUT: RSI must be <= (through midline down)", group="Entry")

// ── OPTIONAL MACD-shift confirmation (DEFAULT OFF — tested worse as a hard gate) ──
useMacdShift  = input.bool(false, "Require MACD shift within last N bars (A/B toggle — tested WORSE)", group="MACD shift (optional)")
macdShiftBars = input.int(2, "  MACD shift lookback (bars)", minval=1, maxval=4, group="MACD shift (optional)")

// ── session window + exit ──
sessStart = input.int(940,  "Session start (HHMM IST)", group="Session/Exit")
sessEnd   = input.int(1415, "Latest new entry (HHMM IST)", group="Session/Exit")
exitOnMacdFlip = input.bool(true, "Exit label on opposite MACD flip", group="Session/Exit")
exitOnAdxRoll  = input.bool(true, "Exit label on ADX rollover", group="Session/Exit")
sendExitAlert  = input.bool(false, "Send EXIT alert JSON (else labels only; bot manages real exits)", group="Session/Exit")
showLabels = input.bool(true, "Show labels", group="Session/Exit")

isOneMin = timeframe.isminutes and timeframe.multiplier == 1

// ── session-anchored VWAP proxy (equal-weight mean of hlc3; index has no volume) ──
var float sumSrc = na
var int   nBars  = 0
var bool  entryOpenCE = false
var bool  entryOpenPUT = false
isNewDay = ta.change(time("D")) != 0
if isNewDay
    sumSrc := 0.0
    nBars  := 0
    entryOpenCE := false
    entryOpenPUT := false
sumSrc := sumSrc + hlc3
nBars  := nBars + 1
vwapProxy = sumSrc / nBars

// ── indicators compute ──
rsi = ta.rsi(close, rsiLen)
[diP, diM, adxVal] = ta.dmi(adxLen, adxLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSig)

adxRising = adxVal > adxVal[adxRiseBars]
vwapUp    = vwapProxy > vwapProxy[vwapSlopeBars]
vwapDn    = vwapProxy < vwapProxy[vwapSlopeBars]
adxOK     = not useAdxCap or adxVal <= adxCap

// MACD shift (optional confirmation): a cross in the last N bars
macdCrossUp = ta.crossover(macdLine, macdSignal)
macdCrossDn = ta.crossunder(macdLine, macdSignal)
recentUp = false
recentDn = false
for i = 0 to macdShiftBars
    recentUp := recentUp or macdCrossUp[i]
    recentDn := recentDn or macdCrossDn[i]
macdConfCE  = not useMacdShift or recentUp
macdConfPUT = not useMacdShift or recentDn

// ── session window ──
hourIST = hour(time, "Asia/Kolkata")
minIST  = minute(time, "Asia/Kolkata")
hhmm    = hourIST * 100 + minIST
inWindow = hhmm >= sessStart and hhmm <= sessEnd

// ── ENTRIES ──
ceRaw = adxRising and adxOK and vwapUp and close > vwapProxy and rsi >= rsiCE and macdConfCE and inWindow and isOneMin
puRaw = adxRising and adxOK and vwapDn and close < vwapProxy and rsi <= rsiPUT and macdConfPUT and inWindow and isOneMin

entryCE  = ceRaw and not entryOpenCE
entryPUT = puRaw and not entryOpenPUT

// ── EXIT signals (opposite MACD flip OR ADX rollover) ──
adxRoll = adxVal < adxVal[2]
exitCE  = entryOpenCE and ((exitOnMacdFlip and macdCrossDn) or (exitOnAdxRoll and adxRoll)) and isOneMin
exitPUT = entryOpenPUT and ((exitOnMacdFlip and macdCrossUp) or (exitOnAdxRoll and adxRoll)) and isOneMin

// ── latches (one CE + one PUT leg at a time; re-arm on exit or side flip) ──
if entryCE
    entryOpenCE := true
if entryPUT
    entryOpenPUT := true
if exitCE or close < vwapProxy
    entryOpenCE := false
if exitPUT or close > vwapProxy
    entryOpenPUT := false

// ── ALERT JSON (matches bot payload; confidence/score=90 required) ──
fv(x) => str.tostring(x, format.mintick)
fi(x) => str.tostring(x, "#.##")
jsonCE  = '{"symbol":"' + syminfo.ticker + '","action":"BUY","confidence":"90","score":"90","entry_type":"NIFTY_ADX_IGNITE","price":"' + fv(close) + '","vwap_value":"' + fv(vwapProxy) + '","rsi_value":"' + fi(rsi) + '","adx_value":"' + fi(adxVal) + '","macd_hist":"' + fi(macdHist) + '","tv_setup_label":"NIFTY_ADX_CE"}'
jsonPUT = '{"symbol":"' + syminfo.ticker + '","action":"SELL","original_action":"BUY_PUT","option_side":"PE","confidence":"90","score":"90","entry_type":"NIFTY_ADX_IGNITE","price":"' + fv(close) + '","vwap_value":"' + fv(vwapProxy) + '","rsi_value":"' + fi(rsi) + '","adx_value":"' + fi(adxVal) + '","macd_hist":"' + fi(macdHist) + '","tv_setup_label":"NIFTY_ADX_PUT"}'
jsonExit = '{"symbol":"' + syminfo.ticker + '","action":"SELL","is_exit":"true","entry_type":"NIFTY_ADX_EXIT","price":"' + fv(close) + '","tv_setup_label":"NIFTY_ADX_EXIT"}'

alertcondition(entryCE,  title="NIFTY CE Entry",  message="NIFTY_ADX_CE_ENTRY")
alertcondition(entryPUT, title="NIFTY PUT Entry", message="NIFTY_ADX_PUT_ENTRY")
if entryCE
    alert(jsonCE, alert.freq_once_per_bar_close)
if entryPUT
    alert(jsonPUT, alert.freq_once_per_bar_close)
if sendExitAlert and (exitCE or exitPUT)
    alert(jsonExit, alert.freq_once_per_bar_close)

// ── plots + labels ──
plot(vwapProxy, "Session VWAP (proxy)", color=color.new(color.blue, 0), linewidth=2)
plot(adxVal, "ADX", color=color.orange, display=display.data_window)
plot(rsi, "RSI", color=color.purple, display=display.data_window)
bgcolor(not isOneMin ? color.new(color.red, 88) : na, title="Use 1-Minute Chart")

if showLabels and entryCE
    label.new(bar_index, low, "CE\nADX " + fi(adxVal) + "\nRSI " + fi(rsi), style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
if showLabels and entryPUT
    label.new(bar_index, high, "PUT\nADX " + fi(adxVal) + "\nRSI " + fi(rsi), style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
if showLabels and (exitCE or exitPUT)
    label.new(bar_index, exitCE ? high : low, "EXIT", style=label.style_label_left, color=color.new(color.gray, 30), textcolor=color.white, size=size.tiny)
