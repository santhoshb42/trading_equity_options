//@version=6
indicator("Sniper 7.59-E – MACD Reversal (1-Min)", overlay=true, max_labels_count=500)
// ⚠️ IMPORTANT: Run this script on 1-MINUTE chart only
// ⚠️ Trading window: 09:30 - 15:30 IST

//──────── INPUTS ────────
emaFast = input.int(9, "EMA Fast")
emaSlow = input.int(20, "EMA Slow")
rsiLen = input.int(14, "RSI Length")
rsiMin = input.float(45.0, "RSI Min Entry (Reversal)")
macdFast = input.int(12, "MACD Fast")
macdSlow = input.int(26, "MACD Slow")
macdSignalLen = input.int(9, "MACD Signal")
bbLen = input.int(20, "BB Length")
bbStd = input.float(2.0, "BB StdDev")
volMaLen = input.int(20, "Volume MA Length")
volMultiplier = input.float(1.2, "Volume Multiplier")
niftySymbol = input.symbol("NSE:NIFTY", "NIFTY Symbol")
showLabels = input.bool(true, "Show Labels")
isExpectedTimeframe = timeframe.isminutes and timeframe.multiplier == 1

//──────── CORE INDICATORS ────────
ema9 = ta.ema(close, emaFast)
ema20 = ta.ema(close, emaSlow)
rsi = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)
[bbUpper, bbMiddle, bbLower] = ta.bb(close, bbLen, bbStd)
bbWidth = (bbUpper - bbLower) / bbMiddle * 100
volMa = ta.sma(volume, volMaLen)
vwapVal = ta.vwap(hlc3)
prevDayClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
nifty50PrevClose = request.security(niftySymbol, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
nifty50Close = request.security(niftySymbol, "D", close, barmerge.gaps_off, barmerge.lookahead_off)
nifty50Change = nifty50PrevClose > 0 ? (nifty50Close - nifty50PrevClose) / nifty50PrevClose * 100 : 0

//──────── TREND FILTER ────────
// Pre-calculate ta.rising() on every bar (Pine v6 requirement)
macdHistRising = ta.rising(macdHist, 2)
// For MACD_REVERSAL: Require ACTUAL trend alignment (EMA rising), not just histogram recovery
emaTrendStrict = ema9 > ema20 and ema20 > ema20[1]  // Strict: actual EMA uptrend
emaTrendFlexible = ema9 > ema20 or macdHistRising   // Flexible: allow recovery phase
emaSupport = low >= ema9 or close > ema9
emaSlope = ema9 > ema9[1] and ema9[1] > ema9[2]
trendFilterStrict = emaTrendStrict and emaSupport and emaSlope  // For MACD_REVERSAL
trendFilterFlexible = emaTrendFlexible and emaSupport and emaSlope  // For DEEP_MACD_REVERSAL

//──────── VOLUME FILTER (MUST BE BEFORE FIRST USE) ────────
volFilter = volume > volMa * volMultiplier

//──────── CANDLE BODY EXPANSION FILTER ────────
// Detects strong candle bodies (removes weak/doji reversals)
bodySize = math.abs(close - open)
avgBody = ta.sma(bodySize, 10)
strongCandle = bodySize > avgBody * 1.2

//──────── CANDLE RANGE EXPANSION FILTER ────────
// Detects true displacement candles (high-low range expansion, not just body)
// Catches momentum ignition better than body expansion alone
candleRange = high - low
avgRange = ta.sma(candleRange, 10)
rangeExpansion = candleRange > avgRange * 1.3

//──────── ATR EXPANSION FILTER (Options Move Hard on Volatility) ────────
// ATR rising = volatility expanding (options love this)
atr = ta.atr(14)
atrExpansion = atr > atr[1]

//──────── BB EXPANSION FILTER (IMPROVED) ────────
// Stronger compression detection: Bollinger band width contracts to 80% of avg
bbAvgWidth = ta.sma(bbWidth, 10)
bbCompression = bbWidth < bbAvgWidth * 0.8  // True volatility contraction
bbExpansion = bbWidth > bbWidth[1] and bbWidth[1] >= bbWidth[2] and bbWidth[2] >= bbWidth[3]
bbFilter = bbCompression or (bbExpansion and close > bbMiddle)

//──────── RSI RECOVERY FILTER (MACD Reversal) ────────
rsiRising = ta.rising(rsi, 2)
rsiRecovery = rsi > rsiMin and rsiRising

//──────── MACD HISTOGRAM REVERSAL FILTER (3-CANDLE CHECK) ────────
// Detects when MACD histogram shifts from negative to positive over 3 candles
// [2] was negative → [0] is now positive (3-candle transition)
macdNegative3CandlesAgo = macdHist[2] < 0
macdPositiveNow = macdHist > 0
macdRevealCrossover = macdNegative3CandlesAgo and macdPositiveNow and macdHist[1] > macdHist[2]
macdHistStrength = macdHist > macdHist[1] and macdHist[1] > macdHist[2]

//──────── SHIFT / BURST MODEL (3-CANDLE SEQUENCE) ────────
// Candle 0 ([2]) is negative, candle 1 ([1]) flips positive, and candle 2 ([0]) fires only if the histogram expands hard again.
histShiftPrevBar = macdHist[1] > 0 and macdHist[2] <= 0
histConfirmCandle1 = macdHist[1] > 0.05
histBurstCandle2 = histConfirmCandle1 and macdHist > macdHist[1] * 1.5
priceBurstCandle2 = open > close[1]
volumeBurstCandle2 = volume > volMa
sequenceReady = histShiftPrevBar and histBurstCandle2 and priceBurstCandle2 and volumeBurstCandle2

// Preserve the existing telemetry fields using the new burst model.
histShiftCandle0 = histShiftPrevBar
macdLineConfirmCandle1 = macdLine[1] >= macdLine[2] and macdSignal[1] >= macdSignal[2]
rsiConfirmCandle1 = rsi > rsi[1]
volumeConfirmCandle1 = volumeBurstCandle2
emaConfirmCandle1 = priceBurstCandle2
vwapConfirmCandle1 = histConfirmCandle1
bbConfirmCandle1 = histConfirmCandle1
priceConfirmCandle1 = priceBurstCandle2
openStrengthCandle2 = priceBurstCandle2

// Classify the same burst setup by the MACD regime on the shift candle.
deepContext = macdLine[1] <= 0 and macdSignal[1] <= 0
accelerationContext = macdLine[1] > 0 and macdSignal[1] > 0
neutralReversalContext = not deepContext and not accelerationContext

// The burst rule itself is the acceleration check.
histVelocity = histBurstCandle2

// Safety check: Distance from EMA (avoid both falling knives and late chases)
distanceFromEMA = math.abs(close - ema9) / ema9 * 100
confirmDistanceFromEMA = math.abs(close[1] - ema9[1]) / ema9[1] * 100
notExtended = distanceFromEMA < 1.5
confirmNotExtended = confirmDistanceFromEMA < 1.5
rsiDeepOversold = rsi[2] < 45 or rsi[1] < 45
deepReversalSetup = deepContext and sequenceReady

//──────── PRICE STRUCTURE & VWAP FILTER ────────
// Momentum structure (higher lows = reversal structure)
higherLow = low > low[1] and low[1] >= low[2]
bullishClose = close > open
// VWAP rising: price above VWAP AND VWAP itself rising (institutional flow up)
vwapRising = close > vwapVal and vwapVal > vwapVal[1]
priceStructure = higherLow and bullishClose and vwapRising

//──────── TIME FILTER (9:30 - 15:30 IST) ────────
// Explicit timezone handling instead of relying on chart exchange timezone
hourIST = hour(time, "Asia/Kolkata")
minuteIST = minute(time, "Asia/Kolkata")
inTradeWindow = (hourIST == 9 and minuteIST >= 30) or (hourIST >= 10 and hourIST < 15) or (hourIST == 15 and minuteIST <= 30)

//──────── CONFIDENCE SCORING (MACD Reversal) ────────
score = 0.0
score += neutralReversalContext ? 20 : 0
score += histShiftPrevBar ? 20 : 0
score += histBurstCandle2 ? 25 : 0
score += macdHist > 0.05 ? 10 : 0
score += priceBurstCandle2 ? 15 : 0
score += volumeBurstCandle2 ? 10 : 0

//──────── DEEP REVERSAL CONFIDENCE (Lower base, requires strong confirmation) ────────
deepScore = 0.0
deepScore += deepContext ? 20 : 0
deepScore += histShiftPrevBar ? 20 : 0
deepScore += histBurstCandle2 ? 25 : 0
deepScore += macdHist > 0.05 ? 10 : 0
deepScore += priceBurstCandle2 ? 15 : 0
deepScore += volumeBurstCandle2 ? 10 : 0

//──────── MOMENTUM ACCELERATION FILTERS (Already-positive MACD regime only) ────────
// This is re-acceleration after a shallow pause, not a fresh reversal from weak regime.
momentumTrendStrict = ema9[1] > ema20[1] and ema20[1] >= ema20[2] and close[1] > ema9[1]
momentumHistAccel = histShiftCandle0 and histConfirmCandle1 and histVelocity
momentumRSI = rsi[1] > 50 and rsi[1] > rsi[2]
momentumVolume = volumeConfirmCandle1
momentumCandles = close[1] > open[1] and close[1] >= close[2]
momentumVol = atr[1] >= atr[2] or bbWidth[1] >= bbWidth[2]
momentumNotExtended = confirmNotExtended and open < bbUpper

momentumAccelSetup = accelerationContext and sequenceReady

//──────── MOMENTUM ACCELERATION CONFIDENCE (Directional, not reversal) ────────
momScore = 0.0
momScore += accelerationContext ? 20 : 0
momScore += histShiftPrevBar ? 20 : 0
momScore += histBurstCandle2 ? 25 : 0
momScore += macdHist > 0.05 ? 10 : 0
momScore += priceBurstCandle2 ? 15 : 0
momScore += volumeBurstCandle2 ? 10 : 0

//──────── ENTRY TRIGGERS ────────
// Price must be above previous day close (avoid bad day losses)
priceAbovePrevClose = close > prevDayClose

// MACD_REVERSAL: same burst setup, but MACD is in a mixed-sign transition regime.
macdReversalSetup = neutralReversalContext and sequenceReady

// DEEP_MACD_REVERSAL: recent histogram shift confirmed one candle later from a weak / negative regime
deepReversalTrigger = deepReversalSetup and inTradeWindow and isExpectedTimeframe and priceAbovePrevClose

// MOMENTUM_ACCELERATION: recent histogram re-acceleration from an already-positive regime
momentumAccelTrigger = momentumAccelSetup and inTradeWindow and isExpectedTimeframe and not deepReversalTrigger and priceAbovePrevClose

// Keep the legacy MACD_REVERSAL path from swallowing setups that now have an explicit 3-candle label.
macdReversalTrigger = macdReversalSetup and isExpectedTimeframe and not deepReversalTrigger and not momentumAccelTrigger and priceAbovePrevClose

//──────── SIGNAL METRICS ────────
trend_strength = ema9 - ema9[1]
rsi_expansion = rsi - rsi[1]
momentum_score = score
vol_expanding = volFilter ? 1 : 0
atr_expanding = atrExpansion ? 1 : 0
hist_accelerating = histVelocity ? 1 : 0
range_expanding = rangeExpansion ? 1 : 0
price_extended = notExtended ? 0 : 1
volume_ratio = volMa > 0 ? volume / volMa : 0.0
vwap_distance = vwapVal > 0 ? (close - vwapVal) / vwapVal * 100 : 0.0
ema_spread = ema20 > 0 ? (ema9 - ema20) / ema20 * 100 : 0.0
atr_pc = close > 0 ? atr / close * 100 : 0.0
signal_confidence = macdReversalTrigger ? math.max(90.0, math.min(100.0, score / 85.0 * 100.0)) : math.min(100.0, score / 85.0 * 100.0)
deep_confidence = deepReversalTrigger ? math.max(70.0, math.min(95.0, deepScore / 75.0 * 100.0)) : math.min(95.0, deepScore / 75.0 * 100.0)
mom_confidence = momentumAccelTrigger ? math.max(80.0, math.min(90.0, momScore / 80.0 * 100.0)) : math.min(90.0, momScore / 80.0 * 100.0)

// Dynamic market_trend based on NIFTY50 daily change
market_trend_label = nifty50Change >= 0.5 ? "GOOD" : nifty50Change > -0.4 ? "NEUTRAL" : "BAD"
day_change = prevDayClose > 0 ? (close - prevDayClose) / prevDayClose * 100 : na

//──────── ALERT JSON - MACD_REVERSAL ────────
format_value(x) => str.tostring(x, format.mintick)

jsonMsg_MACDReversal = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"MACD_REVERSAL\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(score) + "\",\"confidence\":\"" + format_value(signal_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(momentum_score) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"MACD_REVERSAL\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

//──────── ALERT JSON - DEEP_MACD_REVERSAL ────────
jsonMsg_DeepReversal = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"DEEP_MACD_REVERSAL\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(deepScore) + "\",\"confidence\":\"" + format_value(deep_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(deepScore) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"price_extended\":\"" + str.tostring(price_extended) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"DEEP_MACD_REVERSAL\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

//──────── ALERT JSON - MOMENTUM_ACCELERATION ────────
jsonMsg_MomentumAccel = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"MOMENTUM_ACCELERATION\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(momScore) + "\",\"confidence\":\"" + format_value(mom_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(momScore) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"price_extended\":\"" + str.tostring(price_extended) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"MOMENTUM_ACCELERATION\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

//──────── ALERT CONDITIONS ────────
// TradingView Alert Dialog: Use alertcondition() with static message (Pine v6 limitation: no series strings)
alertcondition(macdReversalTrigger, title="MACD Reversal Entry", message="MACD_REVERSAL_ENTRY")
alertcondition(deepReversalTrigger, title="Deep MACD Reversal Entry", message="DEEP_MACD_REVERSAL_ENTRY")
alertcondition(momentumAccelTrigger, title="Momentum Acceleration Entry", message="MOMENTUM_ACCELERATION_ENTRY")

// Chart reload: Use alert() with full JSON payload
if macdReversalTrigger
    alert(jsonMsg_MACDReversal, alert.freq_once_per_bar_close)
if deepReversalTrigger
    alert(jsonMsg_DeepReversal, alert.freq_once_per_bar)
if momentumAccelTrigger
    alert(jsonMsg_MomentumAccel, alert.freq_once_per_bar)

//──────── LABELS ────────
if showLabels and macdReversalTrigger
    label.new(bar_index, high, "ENTRY\n(MR)\n" + str.tostring(score), style=label.style_label_down, color=color.green, textcolor=color.white, size=size.tiny)
if showLabels and deepReversalTrigger
    label.new(bar_index, high + 0.5, "ENTRY\n(MDR)\n" + str.tostring(deepScore), style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.tiny)
if showLabels and momentumAccelTrigger
    label.new(bar_index, high + 1.0, "ENTRY\n(MOM)\n" + str.tostring(momScore), style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.tiny)

plotshape(showLabels and macdReversalTrigger, title="ENTRY FLAG - MACD_REVERSAL", text="MR", style=shape.labelup, location=location.belowbar, color=color.lime, textcolor=color.black, size=size.tiny)
plotshape(showLabels and deepReversalTrigger, title="ENTRY FLAG - DEEP_MACD_REVERSAL", text="MDR", style=shape.labelup, location=location.belowbar, color=color.orange, textcolor=color.black, size=size.tiny)
plotshape(showLabels and momentumAccelTrigger, title="ENTRY FLAG - MOMENTUM_ACCELERATION", text="MOM", style=shape.labelup, location=location.belowbar, color=color.aqua, textcolor=color.black, size=size.tiny)

//──────── PLOTS ────────
plot(ema9, color=color.yellow, title="EMA9")
plot(ema20, color=color.orange, title="EMA20")
plot(bbUpper, color=color.gray, title="BB Upper")
plot(bbLower, color=color.gray, title="BB Lower")
bgcolor(not isExpectedTimeframe ? color.new(color.red, 88) : na, title="Use 1-Minute Chart")
