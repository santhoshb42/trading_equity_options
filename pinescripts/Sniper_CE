jsonMsg_DeepReversal = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"DEEP_MACD_REVERSAL\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(deepScore) + "\",\"confidence\":\"" + format_value(deep_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(deepScore) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"price_extended\":\"" + str.tostring(price_extended) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"DEEP_MACD_REVERSAL\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

jsonMsg_MomentumAccel = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"MOMENTUM_ACCELERATION\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(momScore) + "\",\"confidence\":\"" + format_value(mom_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(momScore) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"price_extended\":\"" + str.tostring(price_extended) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"MOMENTUM_ACCELERATION\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

jsonMsg_MomentumContinuation = "{\"symbol\":\"" + syminfo.ticker + "\",\"action\":\"BUY\",\"entry_type\":\"MOMENTUM_CONTINUATION\",\"price\":\"" + format_value(close) + "\",\"score\":\"" + format_value(contScore) + "\",\"confidence\":\"" + format_value(cont_confidence) + "\",\"market_trend\":\"" + market_trend_label + "\",\"trend_strength\":\"" + format_value(trend_strength) + "\",\"momentum_score\":\"" + format_value(contScore) + "\",\"rsi_value\":\"" + format_value(rsi) + "\",\"rsi_expansion\":\"" + format_value(rsi_expansion) + "\",\"macd_hist\":\"" + format_value(macdHist) + "\",\"bb_width\":\"" + format_value(bbWidth) + "\",\"day_change\":\"" + format_value(day_change) + "\",\"vol_expanding\":\"" + str.tostring(vol_expanding) + "\",\"atr_expanding\":\"" + str.tostring(atr_expanding) + "\",\"hist_accelerating\":\"" + str.tostring(hist_accelerating) + "\",\"range_expanding\":\"" + str.tostring(range_expanding) + "\",\"price_extended\":\"" + str.tostring(price_extended) + "\",\"vwap_distance\":\"" + format_value(vwap_distance) + "\",\"volume_ratio\":\"" + format_value(volume_ratio) + "\",\"ema_spread\":\"" + format_value(ema_spread) + "\",\"atr_pc\":\"" + format_value(atr_pc) + "\",\"tv_setup_label\":\"MOMENTUM_CONTINUATION\",\"reentry_context_active\":\"false\",\"nifty50_change\":\"" + format_value(nifty50Change) + "\"}"

//──────── ALERT CONDITIONS ────────
alertcondition(macdReversalTrigger,          title="MACD Reversal Entry",          message="MACD_REVERSAL_ENTRY")
alertcondition(deepReversalTrigger,          title="Deep MACD Reversal Entry",     message="DEEP_MACD_REVERSAL_ENTRY")
alertcondition(momentumAccelTrigger,         title="Momentum Acceleration Entry",  message="MOMENTUM_ACCELERATION_ENTRY")
alertcondition(momentumContinuationTrigger,  title="Momentum Continuation Entry",  message="MOMENTUM_CONTINUATION_ENTRY")

if macdReversalTrigger
    alert(jsonMsg_MACDReversal, alert.freq_once_per_bar_close)
if deepReversalTrigger
    // v9.14: was freq_once_per_bar (fires mid-candle, unconfirmed — a wick can satisfy the 2x burst
    // and be false by bar close; JSON snapshot of price/rsi/hist was captured at that same unconfirmed
    // moment, so DEEP telemetry wasn't comparable to CONT's). Aligned to bar-close, same as CONT.
    alert(jsonMsg_DeepReversal, alert.freq_once_per_bar_close)
if momentumAccelTrigger
    alert(jsonMsg_MomentumAccel, alert.freq_once_per_bar)
if momentumContinuationTrigger
    alert(jsonMsg_MomentumContinuation, alert.freq_once_per_bar_close)

//──────── LABELS ────────
if showLabels and macdReversalTrigger
    label.new(bar_index, high, "ENTRY\n(MR)\n" + str.tostring(score), style=label.style_label_down, color=color.green, textcolor=color.white, size=size.tiny)
if showLabels and deepReversalTrigger
    label.new(bar_index, high + 0.5, "ENTRY\n(MDR)\n" + str.tostring(deepScore), style=label.style_label_down, color=color.orange, textcolor=color.white, size=size.tiny)
if showLabels and momentumAccelTrigger
    label.new(bar_index, high + 1.0, "ENTRY\n(MOM)\n" + str.tostring(momScore), style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.tiny)
if showLabels and momentumContinuationTrigger
    label.new(bar_index, high + 1.5, "ENTRY\n(CONT)\n" + str.tostring(contScore), style=label.style_label_down, color=color.purple, textcolor=color.white, size=size.tiny)

plotshape(showLabels and macdReversalTrigger,         title="ENTRY FLAG - MACD_REVERSAL",          text="MR",   style=shape.labelup, location=location.belowbar, color=color.lime,   textcolor=color.black, size=size.tiny)
plotshape(showLabels and deepReversalTrigger,          title="ENTRY FLAG - DEEP_MACD_REVERSAL",     text="MDR",  style=shape.labelup, location=location.belowbar, color=color.orange, textcolor=color.black, size=size.tiny)
plotshape(showLabels and momentumAccelTrigger,         title="ENTRY FLAG - MOMENTUM_ACCELERATION",  text="MOM",  style=shape.labelup, location=location.belowbar, color=color.aqua,   textcolor=color.black, size=size.tiny)
plotshape(showLabels and momentumContinuationTrigger,  title="ENTRY FLAG - MOMENTUM_CONTINUATION",  text="CONT", style=shape.labelup, location=location.belowbar, color=color.purple, textcolor=color.black, size=size.tiny)

