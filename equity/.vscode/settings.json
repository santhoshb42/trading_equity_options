{
  "files.watcherExclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/__pycache__": true,
    "**/.venv": true
  },
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": true,
  "[python]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "ms-python.python"
  },
  "python.analysis.extraPaths": ["./eqcode"],
  "editor.rulers": [80, 120],
  "files.exclude": {
    "**/.git": true,
    "**/.pytest_cache": true
  }
}
