//@version=5
indicator("Sniper v7.11 – Smart Hybrid Gainer Engine (9:30–10:30)", overlay=true)

// INPUTS
emaShort = input.int(9,  "EMA Short")
emaLong  = input.int(20, "EMA Long")
rsiLen   = input.int(14, "RSI Length")
dmiLen   = input.int(14, "ADX/DI Length")
atrLen   = input.int(14, "ATR Length")
volLen   = input.int(20, "Vol MA Length")
volMult  = input.float(1.4, "Vol Spike ×", step=0.1)
minRsi   = input.float(58.0, "Min RSI")
maxRsi   = input.float(85.0, "Max RSI")
minAdx   = input.float(20.0, "Min ADX (strict after 9:45)")
minAtrPc = input.float(0.15, "Min ATR% (strict after 9:45)")
minBody  = input.float(0.55, "Min Body Ratio")
exhaustPc= input.float(2.5, "Exhaustion % Above EMA9")
useResistance  = input.bool(true, "Require Resistance Break")
resistanceBars = input.int(3, "Resistance Lookback Bars")
maxGap = input.float(3.0, "Max Gap % Allowed")

// CORE CALCULATIONS
ema9  = ta.ema(close, emaShort)
ema20 = ta.ema(close, emaLong)
vwap  = ta.vwap(hlc3)
rsi   = ta.rsi(close, rsiLen)
atr   = ta.atr(atrLen)
atrPc = atr / close * 100.0
[_, _, adxVal] = ta.dmi(dmiLen, dmiLen)

body      = math.abs(close - open)
barRange  = math.max(high - low, 0.0001)
bodyRatio = body / barRange
pdc = request.security(syminfo.tickerid, "D", close[1])

// TIME WINDOWS
sessionStart = timestamp("GMT+5:30", year, month, dayofmonth, 9, 30)
sessionEnd   = timestamp("GMT+5:30", year, month, dayofmonth, 10, 30)
start933     = timestamp("GMT+5:30", year, month, dayofmonth, 9, 33)
start945     = timestamp("GMT+5:30", year, month, dayofmonth, 9, 45)
inSession = time >= sessionStart and time <= sessionEnd
after933  = time >= start933

// ADAPTIVE FILTERS
adxReq = time < start945 ? 15 : minAdx
fADX   = adxVal >= adxReq
atrReq = time < start945 ? 0.12 : minAtrPc
fATR   = atrPc >= atrReq
volAvg = ta.sma(volume, volLen)
fVolume = volume > volAvg * volMult or volume > ta.sma(volume, 5) * 1.1 or volume > volume[1] * 1.05
exhaust  = (close - ema9) / ema9 * 100.0
fExhaust = exhaust < exhaustPc
fAboveMA = close > ema9 and close > ema20 and close > vwap
rsiLower = time < start945 ? 57.0 : minRsi
fRSI = rsi >= rsiLower and rsi <= maxRsi
fBody = bodyRatio >= minBody
open_gap_pct = na(close[1]) ? 0.0 : (open - close[1]) / close[1] * 100.0
fGap = math.abs(open_gap_pct) < maxGap
prevHigh = ta.highest(high[1], resistanceBars)
fResistance = time < start945 or (not useResistance or close > prevHigh * 1.002)
pdcConfirm = close > pdc or time < start945

// SMART HYBRID ENGINE
earlyEngine = time < start945 and close > vwap and ema9 > ema20 and rsi >= 60 and volume > volAvg * 1.3
lateEngine  = time >= start945 and close > vwap and close > ema20 and adxVal >= 22 and volume > volAvg * 1.4

// ANTI-FADE / NO-DUD FILTER
lowerHighs = high < high[1] and high[1] < high[2]
weakClose  = close < open and close < ema9
midFail    = close < (high + low) / 2
isFading = lowerHighs or weakClose or midFail
strongClose = close > open and close > high[1] and bodyRatio >= 0.55
antiFade = strongClose and not isFading

// BURST LIMITER (3-MIN, MAX 5)
bucket = math.floor(time / (3 * 60000))
var int bucketTrades = 0
var int lastBucket = na
if bucket != lastBucket
    bucketTrades := 0
    lastBucket := bucket
burstOK = bucketTrades < 5

// DAILY LIMIT (MAX 20)
var int dailyTrades = 0
newDay = ta.change(time("D")) != 0
if newDay
    dailyTrades := 0
dailyOK = dailyTrades < 20

// FINAL FILTER DECISION
allFilters = inSession and after933 and (earlyEngine or lateEngine) and antiFade and fATR and fADX and fRSI and fBody and fVolume and fExhaust and fGap and fResistance and pdcConfirm and burstOK and dailyOK

// JSON PAYLOAD
fmt(x) => str.tostring(x, format.mintick)
jsonMsg = "{\"Alerts\":[{\"symbol\":\""+syminfo.ticker+"\",\"action\":\"BUY\",\"price\":\""+fmt(close)+"\",\"score\":\""+fmt(0)+"\",\"confidence\":\""+fmt(0)+"\",\"verdict\":\""+fmt(allFilters ? 1 : 0)+"\",\"vwap\":\""+fmt(vwap)+"\",\"rsi\":\""+fmt(rsi)+"\",\"atr\":\""+fmt(atr)+"\",\"adx\":\""+fmt(adxVal)+"\",\"volume\":\""+fmt(volume)+"\",\"ema9\":\""+fmt(ema9)+"\",\"ema20\":\""+fmt(ema20)+"\",\"pdc\":\""+fmt(pdc)+"\",\"pdc_confirm\":\""+fmt(pdcConfirm ? 1 : 0)+"\"}]}"

// ONE ALERT PER SYMBOL PER DAY
var alertedToday = false
if newDay
    alertedToday := false
alertCond = allFilters and not alertedToday
if alertCond
    alertedToday := true
    bucketTrades += 1
    dailyTrades += 1
    alert(jsonMsg, alert.freq_once_per_bar_close)

// PLOTS
plot(ema9,  "EMA9",  color=color.yellow)
plot(ema20, "EMA20", color=color.orange)
plot(vwap,  "VWAP",  color=color.blue)
