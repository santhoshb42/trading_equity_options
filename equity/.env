# Equity Trading Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# AngelOne API Credentials
# =============================================================================

# Get these from AngelOne SmartAPI portal
ANGEL_API_KEY=PSYIiZ0c
ANGEL_CLIENT_CODE=S635655
ANGEL_PASSWORD=9172
ANGEL_TOTP_SECRET=OZ5ZLOKKYQOIMP2YBW42EZYIWY

# =============================================================================
# Trading Configuration
# =============================================================================

# Trading mode: PAPER (simulation) or LIVE (real trading)
TRADING_MODE=LIVE

# Capital Management (in Rupees)
MAX_CAPITAL=20000
CAP_PER_TRADE=2000
MAX_SLOTS=10
RESERVE_CAPITAL=10000

# Risk Management
DEFAULT_SL_PERCENTAGE=0.5
TRAIL_SL_ENABLED=True
TRAIL_SL_PERCENTAGE=0.5
TRAIL_TRIGGER_PERCENTAGE=0.5

# =============================================================================
# Webhook Server Configuration
# =============================================================================

# Webhook server settings
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Monitor interval in seconds
MONITOR_INTERVAL=20

# Order confirmation timeout in seconds
ORDER_TIMEOUT=30

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Log retention in days
LOG_RETENTION_DAYS=30

# =============================================================================
# Development and Testing
# =============================================================================

# Testing mode (for unit tests)
TESTING_MODE=False

# Debug mode
DEBUG_MODE=False

# =============================================================================
# IMPORTANT NOTES
# =============================================================================

# 1. NEVER commit the actual .env file to version control
# 2. Start with TRADING_MODE=LIVE for testing
# 3. Only switch to TRADING_MODE=LIVE after thorough testing
# 4. Keep your TOTP_SECRET secure - it's like your password
# 5. Use a strong WEBHOOK_SECRET for TradingView integration
# 6. Monitor logs regularly in the logs/DD-MM-YYYY/ directory

# =============================================================================
# How to get AngelOne credentials:
# =============================================================================

# 1. Register at https://smartapi.angelbroking.com/
# 2. Create API credentials in the developer section
# 3. Enable TOTP (Time-based One-Time Password) in your account
# 4. Use Google Authenticator or similar app to get TOTP_SECRET
# 5. The TOTP_SECRET is the QR code secret (base32 string)

# =============================================================================
# Capital Management Examples:
# =============================================================================

# Conservative Setup:
# MAX_CAPITAL=50000
# CAP_PER_TRADE=10000
# MAX_SLOTS=3

# Moderate Setup:
# MAX_CAPITAL=100000
# CAP_PER_TRADE=20000
# MAX_SLOTS=5

# Aggressive Setup:
# MAX_CAPITAL=500000
# CAP_PER_TRADE=50000
# MAX_SLOTS=10
